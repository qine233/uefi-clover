##
#  clover: tail band 6 -- black band on yellow, below LimitsDxe.
#
#  A sixth band means LimitsDxe returned, so the stop is in HashDxe or RngDxe.
#  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail6
  FILE_GUID                      = A7D2C548-9E63-4B10-95FA-3C8E6B2D71A4
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=6

[Depex]
  TRUE
