##
#  clover: the DXE-dispatch checkpoint driver.
#
#  Draws the stage-3 band at its own entry and then records the rest of the DXE
#  phase: one cyan band per architecture/core protocol that appears, at an offset
#  that names it (Include/Checkpoint.h).  It links nothing of the platform's and
#  depends on nothing, so it is dispatched even when the vendor blobs behind it
#  are not; that is the point of having it in APRIORI.
#
#  The [Protocols] list is only a declaration of what it notifies on.  A band
#  still appears for a protocol produced before this driver ran, because
#  RegisterProtocolNotify reports pre-existing instances.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CheckpointDxe
  FILE_GUID                      = 61C9428C-5621-59FD-AF6B-78B46C1F561A
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CheckpointDxeEntry

[Packages]
  MdePkg/MdePkg.dec

[Sources]
  CheckpointDxe.c

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid   ## CONSUMES
  gEfiCpuArchProtocolGuid          ## CONSUMES
  gEfiWatchdogTimerArchProtocolGuid ## CONSUMES
  gEfiTimerArchProtocolGuid        ## CONSUMES
  gEfiRealTimeClockArchProtocolGuid ## CONSUMES
  gEfiVariableArchProtocolGuid     ## CONSUMES
  gEfiVariableWriteArchProtocolGuid ## CONSUMES
  gEfiBlockIoProtocolGuid          ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid ## CONSUMES
  gEfiBdsArchProtocolGuid          ## CONSUMES
  gEfiUsbIoProtocolGuid            ## CONSUMES
  gEfiFirmwareVolume2ProtocolGuid  ## CONSUMES
  gEfiRuntimeArchProtocolGuid      ## CONSUMES
  gEfiSecurityArchProtocolGuid     ## CONSUMES

[Depex]
  TRUE
