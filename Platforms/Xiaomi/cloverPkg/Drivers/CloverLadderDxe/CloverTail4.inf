##
#  clover: tail band 4 -- black band on yellow, below TsensDxe.
#
#  A fourth band means UsbMsdDxe, UsbDeviceDxe, UsbConfigDxe, ButtonsDxe and
#  TsensDxe returned.  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail4
  FILE_GUID                      = B15D3A84-7E26-4C9B-9F50-6D2B8E13A7C4
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=4

[Depex]
  TRUE
