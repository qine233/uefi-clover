##
#  clover: the DXE-dispatch checkpoint driver.
#
#  Draws the stage-3 band at its own entry, paints every slot of the ladder black,
#  recolours one per protocol that exists or appears, puts the FVMAIN file index of
#  the last image the DXE core loaded across seven yellow bit bands, and finishes
#  with three marks that say whether that index is live (Include/Checkpoint.h).  It
#  links nothing of the platform's and depends on nothing, so it is dispatched even
#  when the vendor blobs behind it are not; that is the point of having it in
#  APRIORI.
#
#  A protocol installed before this driver ran still paints its band, but not
#  because RegisterProtocolNotify reports it -- it does not (Hand/Notify.c:139 just
#  appends a record).  The driver drains each registration with LocateHandle
#  (ByRegisterNotify) at entry, which is what makes those instances visible.
#
#  The [Protocols] list declares what it notifies on.  The five Qualcomm and
#  EmbeddedPkg GUIDs are local to the C file and not listed here, because naming
#  them would add packages this bring-up instrument should not need.  MdeModulePkg is
#  here for one reason: the monotonic counter protocol it watches is declared there,
#  not in MdePkg.
#
#  Round 17 added the exception layer, and it is still a consumer of nothing but the
#  CPU arch protocol.  Registering a synchronous-exception callback is one call through
#  the protocol ArmCpuDxe installs, the handler is four stores and a dead loop, and the
#  report goes into bands the boot was never going to use -- see mFaultBits in the C
#  file for why those seven rows are free and what the reading is for.
#
#  Round 18 spends the dependency this file was proud of not having.  Sampling where a
#  stuck loop is sitting needs an interrupt, and the only interrupt this build can take
#  without changing the boot is ArmTimerDxe's tick, which arrives through the GIC's source
#  table rather than through the CPU's exception slots -- ArmGicDxe owns the one CPU IRQ
#  slot and refuses to install its protocol if it cannot have it.  So this driver consumes
#  EFI_HARDWARE_INTERRUPT_PROTOCOL and the generic timer library, which is four calls: take
#  the timer's INTID down, put this driver's handler in its place, read the counter, and
#  write the compare again on every sample.  See mTickBits for what those bands mean, and
#  for the one thing the round gives up: event timeouts after line 32.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CheckpointDxe
  FILE_GUID                      = 61C9428C-5621-59FD-AF6B-78B46C1F561A
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CheckpointDxeEntry

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec

[Sources]
  CheckpointDxe.c

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  ArmLib
  ArmGenericTimerCounterLib
  PcdLib

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid   ## CONSUMES
  gEfiFirmwareVolumeBlockProtocolGuid ## CONSUMES
  gEfiLoadedImageProtocolGuid       ## CONSUMES
  gEfiCpuArchProtocolGuid           ## CONSUMES
  gEfiMonotonicCounterArchProtocolGuid ## CONSUMES
  gEfiVariableWriteArchProtocolGuid ## CONSUMES
  gEfiRealTimeClockArchProtocolGuid ## CONSUMES
  gEfiTimerArchProtocolGuid         ## CONSUMES
  gEfiBlockIoProtocolGuid           ## CONSUMES
  gEfiPartitionInfoProtocolGuid     ## CONSUMES
  gEfiGraphicsOutputProtocolGuid    ## CONSUMES
  gEfiBdsArchProtocolGuid           ## CONSUMES
  gHardwareInterruptProtocolGuid  ## CONSUMES

[Pcd]
  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum  ## CONSUMES
  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum   ## CONSUMES
  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum   ## CONSUMES
  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum      ## CONSUMES

[Depex]
  TRUE
