##
#  clover: tail band 7 -- black band on yellow, below HashDxe.
#
#  A seventh band means HashDxe returned, so the stop is in RngDxe.
#  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail7
  FILE_GUID                      = 1E93B6F0-47C2-4D8A-B63F-5A0E8C27D954
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=7

[Depex]
  TRUE
