##
#  clover: tail band 5 -- black band on yellow, below the removed TzDxe slot.
#
#  A fifth band means dispatch reached LimitsDxe, so the stop is in LimitsDxe,
#  HashDxe or RngDxe.  TzDxeLA itself is not in the volume; the reference
#  lavenderPkg leaves it out too.  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail5
  FILE_GUID                      = 4F0B8E27-6D31-4A95-8C7E-2B5A9D0F3E16
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=5

[Depex]
  TRUE
