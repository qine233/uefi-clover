##
#  clover: tail band 3 -- black band on yellow, below UsbMassStorageDxe.
#
#  A third band means the MdeModulePkg host stack (UsbBusDxe, UsbKbDxe,
#  UsbMassStorageDxe) returned.  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail3
  FILE_GUID                      = 3C7B5E90-2A61-4D8F-B03C-9E71D4A62F58
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=3

[Depex]
  TRUE
