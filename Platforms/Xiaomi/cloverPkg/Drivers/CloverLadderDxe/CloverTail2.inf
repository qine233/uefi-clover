##
#  clover: tail band 2 -- black band on yellow, below UsbfnDwc3Dxe.
#
#  A second band means TLMM, I2C, SPMI, SPI, PmicDxe, AdcDxe, QcomChargerDxe
#  and UsbfnDwc3Dxe all returned.  See CloverLadderDxe.c for the reading table.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CloverTail2
  FILE_GUID                      = 8A4F1D72-5C39-4E60-B7D1-2A9F3C8E5B07
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CloverLadderDxeEntry

[Sources]
  CloverLadderDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  *_*_*_CC_FLAGS = -DCLOVER_TAIL_BAND=2

[Depex]
  TRUE
