##
#  clover: the DXE-dispatch checkpoint driver.
#
#  Draws the stage-3 and stage-4 bars described in Include/Checkpoint.h.  It links
#  nothing of the platform's and depends on nothing, so it is dispatched even when
#  the vendor blobs behind it are not; that is the point of having it in APRIORI.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CheckpointDxe
  FILE_GUID                      = 61C9428C-5621-59FD-AF6B-78B46C1F561A
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CheckpointDxeEntry

[Packages]
  MdePkg/MdePkg.dec

[Sources]
  CheckpointDxe.c

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid ## CONSUMES

[Depex]
  TRUE
